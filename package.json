  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^13.0.1",
    "@grafana/i18n": "^13.0.1",
    "@grafana/runtime": "^13.0.1",
    "@grafana/schema": "^13.0.1",
    "@grafana/ui": "^13.0.1",
